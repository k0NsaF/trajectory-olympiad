{
  "name": "@trajectory/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/project.test.ts tests/trajectory-engine.test.ts tests/trajectory-api.test.ts tests/trajectory-rate-limit.test.ts tests/supabase-service-fetch.test.ts && node --test tests/university-registry-parser.test.mjs tests/olympiad-schedule-parser.test.mjs",
    "registry:import": "node scripts/import-university-registry.mjs",
    "olympiads:import": "node scripts/import-olympiad-season.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "supabase": "3.4.0",
    "tsx": "^4.20.5"
  }
}
